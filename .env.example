# Copy to .env and replace every blank value with a strong, unique secret.
POSTGRES_ADMIN_PASSWORD=
AUTH_DB_PASSWORD=
USERS_DB_PASSWORD=
RAG_DB_PASSWORD=
QDRANT_API_KEY=

# Optional host ports for the only publicly published service (Traefik).
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443

# Leave dimensions blank to use fixed ONNX dimensions; needed for dynamic axes.
MODEL_INPUT_WIDTH=
MODEL_INPUT_HEIGHT=
MODEL_IMAGE_MEAN=0,0,0
MODEL_IMAGE_STD=1,1,1
MAX_IMAGE_BYTES=10485760
MAX_IMAGE_PIXELS=40000000
MODEL_TOP_K=3
MODEL_OUTPUT_ACTIVATION=probabilities

# Auth and users settings. Keep the signing keys and internal token under secrets/,
# not in this file or the source repository.
JWT_ISSUER=leafsense-auth
JWT_AUDIENCE=leafsense-api
JWT_KEY_ID=leafsense-key-1
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

# UID/GID of the owner of local files in secrets/ (Linux development).
HOST_UID=1000
HOST_GID=1000

# RAG document ingestion and local vector embeddings.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384
QDRANT_COLLECTION=leafsense_documents
MAX_DOCUMENT_BYTES=10485760
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
WORKER_POLL_SECONDS=2
WORKER_LEASE_SECONDS=300

# Diagnosis: set the provider key locally; it is optional until a diagnosis
# passes the confidence threshold and matching source chunks are found.
ANALYSIS_SERVICE_URL=http://analysis:8000
DIAGNOSIS_CONFIDENCE_THRESHOLD=0.60
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
